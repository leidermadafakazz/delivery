                  "const runId = Date.now().toString();",
                  "pm.environment.set('runId', runId);",
                  "pm.environment.set('empresa_email', 'empresa.' + runId + '@test.com');",
                  "pm.environment.set('empresa_password', 'Test1234!');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.environment.set('token_empresa', pm.response.json().token);",
                  "pm.test('Rol CLIENT inicial', () => pm.expect(pm.response.json().user.roles).to.include('CLIENT'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Empresa Postman\",\n  \"email\": \"{{empresa_email}}\",\n  \"password\": \"{{empresa_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Cada ejecución genera un correo único con runId."
