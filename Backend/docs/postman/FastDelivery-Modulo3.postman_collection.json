          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('cliente_email', 'cliente.' + pm.environment.get('runId') + '@test.com');",
                  "pm.environment.set('cliente_password', 'Test1234!');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "const jsonBody = pm.response.json();",
                  "pm.environment.set('token_cliente', jsonBody.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
