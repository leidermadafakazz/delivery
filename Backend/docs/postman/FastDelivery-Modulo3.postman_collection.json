{
  "info": {
    "_postman_id": "b7f9f6a2-2d7e-4f3a-9c1e-000000000003",
    "name": "FastDelivery – Módulo 3",
    "description": "Flujo completo del Módulo 3: empresas aprobadas, categorías, productos, catálogo público, búsqueda, disponibilidad, permisos, moderación del administrador y eliminación lógica.\n\nEjecuta la colección en orden o usa el Collection Runner con el entorno 'FastDelivery Local'. Cada ejecución crea usuarios nuevos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Preparación",
      "item": [
        {
          "name": "01 · Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Inicia sesión con el administrador creado por el seed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const jsonBody = pm.response.json();",
                  "pm.environment.set('token_admin', jsonBody.token);",
                  "pm.test('Rol ADMIN', () => pm.expect(jsonBody.user.roles).to.include('ADMIN'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "02 · Registrar usuario empresa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Cada ejecución genera un correo único con runId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Empresa Postman\",\n  \"email\": \"{{empresa_email}}\",\n  \"password\": \"{{empresa_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const runId = Date.now().toString();",
                  "pm.environment.set('runId', runId);",
                  "pm.environment.set('empresa_email', 'empresa.' + runId + '@test.com');",
                  "pm.environment.set('empresa_password', 'Test1234!');",
                  "pm.environment.set('empresa_nombre', 'Restaurante Postman ' + runId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "const jsonBody = pm.response.json();",
                  "pm.environment.set('token_empresa', jsonBody.token);",
                  "pm.test('Rol CLIENT inicial', () => pm.expect(jsonBody.user.roles).to.include('CLIENT'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "03 · Registrar empresa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_empresa}}"
              }
            ],
            "url": "{{baseUrl}}/api/businesses/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"{{empresa_nombre}}\",\n  \"legalName\": \"Restaurante Postman SAS\",\n  \"taxId\": \"NIT-PM-{{runId}}\",\n  \"businessType\": \"RESTAURANT\",\n  \"description\": \"Negocio creado por la colección del Módulo 3\",\n  \"address\": \"Calle 1 #2-3\",\n  \"city\": \"Bogotá\",\n  \"department\": \"Cundinamarca\",\n  \"contactPhone\": \"3001234567\",\n  \"contactEmail\": \"contacto.{{runId}}@test.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "const jsonBody = pm.response.json();",
                  "pm.environment.set('businessId', jsonBody.business.id);",
                  "pm.test('Estado PENDING', () => pm.expect(jsonBody.business.status).to.eql('PENDING'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "04 · Aprobar empresa",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{baseUrl}}/api/businesses/{{businessId}}/approve",
            "description": "El administrador aprueba la empresa para habilitar el catálogo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Empresa aprobada', () => pm.expect(pm.response.json().business.status).to.eql('APPROVED'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "05 · Registrar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
