    {
      "name": "4. Catálogo público",
      "item": [
        {
          "name": "17 · Listar empresas aprobadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/businesses?limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const jsonBody = pm.response.json();",
                  "const mine = jsonBody.businesses.find(b => String(b.id) === String(pm.environment.get('businessId')));",
                  "pm.test('Empresa visible', () => pm.expect(mine).to.not.be.undefined);",
                  "pm.test('Dos productos públicos', () => pm.expect(mine.productCount).to.eql(2));",
                  "pm.test('Sin datos sensibles', () => pm.expect(mine).to.not.have.property('taxId'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "18 · Detalle del catálogo público",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/businesses/{{businessId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const jsonBody = pm.response.json();",
                  "const products = [...jsonBody.categories.flatMap(c => c.products), ...jsonBody.uncategorized];",
                  "pm.test('Dos productos en total', () => pm.expect(products).to.have.lengthOf(2));",
                  "pm.test('Precio numérico', () => pm.expect(products[0].price).to.be.a('number'));",
                  "pm.test('Incluye la categoría creada', () => pm.expect(jsonBody.categories.some(c => String(c.id) === String(pm.environment.get('categoria1Id')))).to.eql(true));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
